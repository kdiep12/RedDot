# (In .gitignore, comments must be on their own line: a "#" after a pattern is part of it.)

# ---- Reinstallable: restore after cloning ----
# cd red-dot && npm install
node_modules/
# cd red-dot/src/components/RedDotCode/redDotServer && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
.venv/
__pycache__/
*.pyc

# ---- Generated ----
# npm run build
dist/
dist-ssr/
# Vite's cache
.vite/
*.log
*.tsbuildinfo

# ---- Voice recordings from the speech detector: personal data, not code ----
debug-audio/
*.wav
# The transcription API's data: your vocabulary, corrections and (optionally) voice notes
dictation-data/

# ---- Secrets and local settings, in case they ever appear ----
.env
.env.local
.env.*.local
*.pem
id_rsa*
id_ed25519*

# ---- Android: build output, local settings, signing keys and built apps ----
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/keystore.properties
*.jks
*.keystore
*.apk
*.aab

# ---- Editors and operating systems ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
